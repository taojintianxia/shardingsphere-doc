+{{% tab name="Grammar" %}}
+```sql
+CreateShardingKeyGenerator ::=
+  'CREATE' 'SHARDING' 'KEY' 'GENERATOR' ifNotExists? keyGeneratorName '(' algorithmDefinition ')'
+
+ifNotExists ::=
+  'IF' 'NOT' 'EXISTS'
+
+algorithmDefinition ::=
+  'TYPE' '(' 'NAME' '=' algorithmType (',' propertiesDefinition)? ')'
+
+propertiesDefinition ::=
